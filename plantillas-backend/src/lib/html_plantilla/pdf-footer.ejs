<div style="width: 100%; box-sizing: border-box; padding: 0 25mm; font-family: 'Open Sans', 'DejaVu Sans', Arial, Helvetica, sans-serif; -webkit-print-color-adjust: exact; print-color-adjust: exact;">
  <div style="border-top: 1.5pt solid #c4a484; padding-top: 5px; display: flex; justify-content: space-between; align-items: center; font-size: 7.8pt; color: #333; line-height: 10.5pt;">
    <div style="width: 50px;"></div>
    <div style="text-align: center; flex: 1;">
      <%= (typeof entidad !== 'undefined' && entidad && entidad.direccion) ? entidad.direccion : 'ZONA PROGRESO, CALLE RAVELO S/N, ENTRE BOLIVAR Y ABAROA, UYUNI - BOLIVIA' %><br>
      <%= (typeof entidad !== 'undefined' && entidad && entidad.nit) ? entidad.nit : 'M.C./NIT: 484874028' %> | <%= (typeof entidad !== 'undefined' && entidad && entidad.telefono) ? entidad.telefono : 'TELEFONO: 71617875' %> | <%= (typeof entidad !== 'undefined' && entidad && entidad.correo) ? entidad.correo : 'CORREO: contacto@marabuntarl.com' %><br>
      <%= (typeof entidad !== 'undefined' && entidad && entidad.web) ? entidad.web : 'marabuntarl.com' %>
    </div>
    <div style="width: 50px; text-align: right; font-size: 9.5pt; font-weight: 700; color: #444; white-space: nowrap;">
      <span class="pageNumber"></span>/<span class="totalPages"></span>
    </div>
  </div>
</div>
