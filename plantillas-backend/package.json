{
  "name": "PlantillasFormlyBackend",
  "version": "1.0.0",
  "description": "Creador de plantillas formly",
  "main": "index.js",
  "scripts": {
    "docker:up": "docker compose up -d postgres",
    "start": "node index.js",
    "test": "npm run docker:up && NODE_ENV=test mocha --exit --timeout 15000",
    "lint": "eslint *.js lib/*.js src/models/*/*.js src/routes/*/*.js test/*.js src/bl/*/*.js",
    "apidoc": "apidoc -i src/routes/ -o public/apidoc",
    "setup": "sequelize db:seed:all --config src/config/sequelize-cli-config.js --seeders-path src/seeders",
    "startdev": "nodemon --exec 'node index.js'",
    "generar": "node generarToken.js",
    "migrar": "sequelize db:migrate --config src/config/sequelize-cli-config.js --migrations-path src/migrations",
    "setup:clean": "FORCE=true node index.js && sequelize db:seed:all --config src/config/sequelize-cli-config.js --seeders-path src/seeders"
  },
  "keywords": [
    "node",
    "base",
    "bienes"
  ],
  "apidoc": {
    "name": "API REST - Documentacion",
    "template": {
      "forceLanguage": "es"
    }
  },
  "author": "AGETIC",
  "license": "UNLICENSED",
  "dependencies": {
    "@mosparo/api-client": "^2.0.0",
    "activedirectory": "^0.7.2",
    "ad": "^0.3.2",
    "axios": "^1.20.0",
    "body-parser": "^1.15.0",
    "bullmq": "^6.4.1",
    "colors": "^1.4.0",
    "consign": "^0.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.7.1",
    "ejs": "^3.1.6",
    "express": "^4.18.2",
    "express-fileupload": "^1.1.10",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.2.0",
    "helmet": "^3.4.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.18.1",
    "lzma": "^2.3.2",
    "md5-file": "^4.0.0",
    "moment": "^2.29.4",
    "morgan": "^1.7.0",
    "nodemailer": "^10.2.1",
    "nodemailer-smtp-transport": "^2.4.2",
    "object-hash": "^1.1.4",
    "openid-client": "^4.0.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "passport-ldapauth": "^0.5.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.11.3",
    "prompts": "^2.4.2",
    "puppeteer-core": "^25.16.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.1",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.4.1",
    "uuid": "^14.0.3",
    "validator": "^13.15.35",
    "winston": "^2.2.0"
  },
  "devDependencies": {
    "chai": "^3.5.0",
    "eslint": "^10.13.0",
    "mocha": "^12.0.3",
    "supertest": "^4.0.2"
  }
}
