# ------------------------------
# Configuración del servidor
# ------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------
# Credenciales de base de datos
# ------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plantillas_dev
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# ------------------------------
# Configuración de la aplicación
# ------------------------------
APP_NAME="Plantillas de Aprobación"
APP_VERSION="1.0.0"

# ------------------------------
# Configuración de autenticación
# ------------------------------
JWT_SECRET=tu_jwt_secreto_aqui
JWT_EXPIRES_IN=7d

# ------------------------------
# Configuración de correos
# ------------------------------
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=correo@ejemplo.com
SMTP_PASSWORD=tu_password_smtp_aqui
SMTP_FROM_NAME="Plantillas Aprobación"
SMTP_FROM_EMAIL=notificaciones@ejemplo.com

# ------------------------------
# Configuración de la entidad (pie de PDF)
# ------------------------------
ENTIDAD_NOMBRE="Nombre de la Entidad"
ENTIDAD_DIRECCION="Calle Ejemplo N° 1234, Ciudad, País"
ENTIDAD_NIT="123456789"
ENTIDAD_TELEFONO="+591 2 2222222"
ENTIDAD_CORREO="contacto@ejemplo.com"
ENTIDAD_WEB="https://www.ejemplo.com"

# ------------------------------
# Configuración de QR (opcional, si aún se usa)
# ------------------------------
# QR_VERIFICATION_URL=https://tusitio.com/verificar?codigo=
# (Ya no es necesaria: la URL de verificación se genera automáticamente en el deploy)

# ------------------------------
# Usuarios Base y Autoridad (Inamovibles)
# ------------------------------
SYS_DEFAULT_USER=sys_default
SYS_DEFAULT_PASSWORD=Developer
DEMO_CD_USER=10794552-1J
IDENTIFICADOR_DIRECTOR=2
IDENTIFICADOR_DIRECTOR_UNIDAD=2

# ------------------------------
# Servicios Estatales y Módulos Externos (Deshabilitados por defecto)
# ------------------------------
CIUDADANIA_DIGITAL_HABILITADO=false
APROBACION_CD_HABILITADO=false
APROBACION_CD_URL_VALIDAR=https://interoperabilidad.agetic.gob.bo/fake/aprobacion-documentos/v1/verificaciones
APROBACION_CD_URL=https://interoperabilidad.agetic.gob.bo/fake/aprobacion-documentos/v1/aprobaciones
APROBACION_CD_TOKEN=Bearer [token]

ALMACEN_HABILITADO=false
ALMACEN_ESTADO=http://localhost:8000/
ALMACEN_CONSULTA=http://localhost:8000/api/v2/almacenes/articulos
ALMACEN_CREAR_SOLICITUD=http://localhost:8000/api/v2/almacenes/solicitud
ALMACEN_RECUPERAR=http://localhost:8000/api/v2/almacenes/solicitud
ALMACEN_NOTIFICAR=http://localhost:8000/api/v2/almacenes/solicitud
ALMACEN_PROVEEDOR=http://localhost:8000/api/v2/almacenes/proveedores
ALMACEN_INGRESO=http://localhost:8000/api/v2/almacenes/ingreso
ALMACEN_TOKEN=Bearer TOKEN_ACCESSO

ACTIVOS_HABILITADO=false
ACTIVOS_ESTADO=http://localhost:8000/
ACTIVOS_CONSULTA=http://localhost:8000/api/v2/activos/buscar
ACTIVOS_ASIGNACION=http://localhost:8000/api/v2/activos/asignacion
ACTIVOS_DEVOLUCION=http://localhost:8000/api/v2/activos/devolucion
ACTIVOS_CONSULTA_POR_USUARIO=http://localhost:8000/api/v2/activos/usuario
ACTIVOS_TOKEN=Bearer TOKEN_ACCESO

# ------------------------------
# Configuración Redis / BullMQ (Colas de Tareas y Caché)
# ------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------
# Configuración Mosparo (Protección Anti-Bot Soberana)
# ------------------------------
MOSPARO_HOST=https://mosparo.agetic.gob.bo
MOSPARO_PUBLICKEY=
MOSPARO_PRIVATEKEY=
MOSPARO_UUID=
DISABLE_MOSPARO=false
